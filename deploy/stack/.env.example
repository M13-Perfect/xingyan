# ===== 必改：对外访问地址（把 your-vps-ip 换成 VPS 公网 IP 或域名） =====
# 浏览器打开业务系统用的地址（不带末尾斜杠）
FRONTEND_PUBLIC_URL=http://your-vps-ip
# 浏览器访问 Casdoor 认证服务用的地址（不带末尾斜杠）
CASDOOR_PUBLIC_URL=http://your-vps-ip:8000

# ===== 端口（与上面地址里的端口保持一致） =====
FRONTEND_PORT=80
CASDOOR_PORT=8000

# ===== 密钥（保持 GENERATE 不动，vps-bootstrap.sh 会自动生成随机值） =====
DB_ROOT_PASSWORD=GENERATE
# Casdoor xyyx-web 应用的 Client Secret；首次启动会随种子写入 Casdoor
CASDOOR_CLIENT_SECRET=GENERATE
# 手机号隐私模块的加密/索引密钥（格式 v1:base64密钥）。一旦有数据后不可随意更换！
XYYX_PHONE_ENC_KEY_VERSION=v1
XYYX_PHONE_ENC_KEYS=GENERATE
XYYX_PHONE_HASH_KEY_VERSION=v1
XYYX_PHONE_HASH_KEYS=GENERATE
